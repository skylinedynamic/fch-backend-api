# -----------------------------------------------------------------------------
# Monitoring / Ops Tuning
# -----------------------------------------------------------------------------
# Spatie Health check frequency (cron expression). Default every 5 minutes.
HEALTH_CHECK_CRON="*/5 * * * *"
# How many days of health check results to keep in the DB. Default 14.
HEALTH_KEEP_HISTORY_FOR_DAYS=14

# Backup compression level (0-9). Lower = faster, larger. Higher = slower, smaller.
BACKUP_COMPRESSION_LEVEL=6

# Optional external URL to ping when the scheduler runs (e.g. Dead Man's Snitch,
# UptimeRobot, healthchecks.io). Leave empty to rely on the built-in cache-based
# SchedulerRanCheck instead.
SCHEDULE_HEARTBEAT_URL=