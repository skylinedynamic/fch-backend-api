APP_NAME="Four Corner Funding"
APP_ENV=local
APP_KEY=base64:Q+Qwd7iA/B1SuM59tPJEPPo4hL+ELQc3LNVV8/BjtXs=
APP_DEBUG=true

APP_URL="http://127.0.0.1:8000"                     # This will be base url like skylinedynamic.dev or fourcornerfunding.com

INTERNAL_RESOLVER_KEY=                              # long random secret, also set on the edge proxy (X-Internal-Key)
BASE_WEBSITE = "localhost:3000"                     # skylinedynamic.dev or fourcornerfunding.com
PREFIX_API_URL = "http://127.0.0.1:8000/api/v1"     # https://api.skylinedynamic.dev/api/v1 or https://api.fourcornerfunding.com/api/v1
BASE_API_URL = "http://127.0.0.1:8000"              # https://api.skylinedynamic.dev or https://api.fourcornerfunding.com
BASE_PARTNER_PORTAL = "localhost:5174"              # https://admin.skylinedynamic.dev or https://partner.fourcornerfunding.com
BASE_BORROWER_PORTAL = "localhost:5173"             # https://client.skylinedynamic.dev or https://app.fourcornerfunding.com

# Reverse proxy / load balancer addresses whose X-Forwarded-* headers are trusted.
# Comma separated IPs or CIDRs. Defaults to loopback + RFC1918 private ranges.
# Set this to your edge address when the proxy sits on a public IP.
# TRUSTED_PROXIES="10.0.0.0/8"


API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
# LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fch-backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

SESSION_DOMAIN=null

# Real-time notifications/reminders go over Laravel Reverb. Set to `reverb`
# and run `php artisan reverb:start` + `php artisan queue:work`; `log` just
# writes broadcasts to the log (the bell still fills on its next fetch).
BROADCAST_CONNECTION=reverb

# Reverb server (reverb:start listens here) ...
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local

# Private files (BUG-016): never reachable by a /storage URL; handed out by the
# API with a short-lived signed URL at /private-files. A folder listed in
# config/files.php private_folders uses FILES_PRIVATE_DISK unless its own
# *_DISK says otherwise (e.g. S3 for one folder later).
FILES_PRIVATE_DISK=local
FILES_SIGNED_URL_MINUTES=60
# AUDIT_DISK=s3        # only to override FILES_PRIVATE_DISK for the audit folder

# AGREEMENT_IMAGE_DISK=s3  # only to override FILES_PRIVATE_DISK for agreement images (config/files.php)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# Mail credentials are NOT set here.
# Each partner's SMTP/SES settings live in `email_configurations` and are applied
# per message by App\Mail\Traits\MailConfig; a partner without their own sends
# through the host partner's. Set them on the Email Configuration settings screen.
# MAIL_MAILER only selects a transport - set it to `log` to write mail to
# storage/logs instead of delivering it.
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="noreply@fourcornerfunding.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_DOC = "docs@fourcornerfunding.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


LOGIN_THROTTLE_LIMIT=5
LOGIN_DECAY_MINUTES=1

# 2FA Configuration
TWO_FA_ENABLED=true
TWO_FA_DEFAULT_METHOD=totp

# TOTP Configuration
TOTP_ISSUER="${APP_NAME}"
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_ALGORITHM=sha1

# SMS (2FA codes and notifications) is configured per partner in
# Settings > SMS Configuration, not here.

# Email 2FA Configuration
EMAIL_2FA_ENABLED=true

SMS_EMAIL_2FA_EXPIRY_MINUTES=5

# 2FA Security Settings
TWO_FA_BACKUP_CODES_COUNT=8
TWO_FA_RECOVERY_CODES_LENGTH=8
TWO_FA_MAX_ATTEMPTS=3
TWO_FA_LOCKOUT_MINUTES=15


# Comma-separated on-call addresses for scheduler failure / health alerts. Empty = none sent.
CRON_ERROR_NOTIFY_EMAILS=



# -----------------------------------------------------------------------------
# Monitoring / Ops Tuning
# -----------------------------------------------------------------------------
# Spatie Health check frequency (cron expression). Default every 5 minutes.
HEALTH_CHECK_CRON="*/5 * * * *"
# How many days of health check results to keep in the DB. Default 14.
HEALTH_KEEP_HISTORY_FOR_DAYS=14

# Backup compression level (0-9). Lower = faster, larger. Higher = slower, smaller.
BACKUP_COMPRESSION_LEVEL=6

# Optional external URL to ping when the scheduler runs (e.g. Dead Man's Snitch,
# UptimeRobot, healthchecks.io). Leave empty to rely on the built-in cache-based
# SchedulerRanCheck instead.
SCHEDULE_HEARTBEAT_URL=

# Telegram: the owner's very short weekly/monthly summary (one-way bot).
# 1. Create a bot with @BotFather and put its token here.
# 2. Open the bot in Telegram and press Start, then run `php artisan telegram:chat-ids`.
# Leave either empty to send nothing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
