                        "subscription"
                    ]
                },
                "description": "Example of creating a minimal partner subscription with mostly null values."
            },
            "response": []
        },
        {
            "name": "Get Partner Subscription Details",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{access_token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/admin/partner-subscriptions/:partnerId",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "admin",
                        "partner-subscriptions",
                        ":partnerId"
                    ],
                    "variable": [
                        {
                            "key": "partnerId",
                            "value": "1",
                            "description": "Partner ID to fetch subscription for"
                        }
                    ]
                },
                "description": "Retrieve subscription details for a specific partner by their ID."
            },
            "response": []
        }
    ],
