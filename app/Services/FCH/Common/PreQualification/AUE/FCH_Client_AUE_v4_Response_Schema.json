{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prompt_version": {
      "type": "string",
      "enum": ["FCH_Client_AUE_v4"]
    },
    "submission_id": { "type": "string" },
    "assessment_title": {
      "type": "string",
      "enum": ["Funding Readiness Assessment"]
    },
    "funding_readiness_summary": { "type": "string" },
    "readiness_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "area": { "type": "string" },
          "assessment": { "type": "string" },
          "source_status": {
            "type": "string",
            "enum": ["VERIFIED", "DOCUMENTED", "BORROWER_REPORTED", "DERIVED_FROM_SUPPLIED_DATA", "CONFLICTING", "NOT_PROVIDED"]
          }
        },
        "required": ["area", "assessment", "source_status"]
      }
    },
    "estimated_funding_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "basis": { "type": "string" }
      },
      "required": ["available", "minimum", "maximum", "basis"]
    },
    "strengths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "areas_requiring_attention": {
      "type": "array",
      "items": { "type": "string" }
    },
    "structuring_considerations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "submission_positioning_overview": { "type": "string" },
    "required_next_steps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete_assessment": {
          "type": "array",
          "items": { "type": "string" }
        },
        "underwriting_review": {
          "type": "array",
          "items": { "type": "string" }
        },
        "submission_readiness": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["complete_assessment", "underwriting_review", "submission_readiness"]
    },
    "important_notice": { "type": "string" },
    "final_disclosure": {
      "type": "string",
      "enum": ["Final funding terms are subject to full underwriting review and verification of submitted documentation."]
    },
    "disclaimer": {
      "type": "string",
      "enum": ["This assessment is not an approval, commitment, or guarantee of financing. Final eligibility, amount, pricing, repayment structure, documentation, and conditions are determined after complete underwriting."]
    }
  },
  "required": ["prompt_version", "submission_id", "assessment_title", "funding_readiness_summary", "readiness_snapshot", "estimated_funding_range", "strengths", "areas_requiring_attention", "structuring_considerations", "submission_positioning_overview", "required_next_steps", "important_notice", "final_disclosure", "disclaimer"]
}
