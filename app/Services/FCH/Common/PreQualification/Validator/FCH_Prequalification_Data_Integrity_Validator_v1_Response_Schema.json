{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "validation_status": {
      "type": "string",
      "enum": ["PASSED", "NEEDS_CORRECTION"]
    },
    "summary": {
      "type": "string",
      "description": "Internal, one-paragraph summary of the data integrity check for FCH staff."
    },
    "borrower_message": {
      "type": ["string", "null"],
      "description": "Borrower-safe correction message. Null when validation_status is PASSED."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "Short machine-readable code, e.g. CREDIT_SOURCE_UNKNOWN."
          },
          "field": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": ["COMPLETENESS", "CONSISTENCY", "DATA_SOURCE", "PLAUSIBILITY", "OTHER"]
          },
          "severity": {
            "type": "string",
            "enum": ["INFO", "WARNING", "BLOCKING"]
          },
          "user_message": {
            "type": "string"
          },
          "evidence_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "internal_message": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "field",
          "category",
          "severity",
          "user_message",
          "evidence_fields",
          "internal_message",
          "suggested_action"
        ]
      }
    }
  },
  "required": ["validation_status", "summary", "borrower_message", "issues"]
}
